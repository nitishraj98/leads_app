SECRET_KEY=your-secret-key-here
LEADS_API_KEY=your-api-key-here

DB_HOST=localhost
DB_PORT=5432
DB_NAME=leads_db
DB_USER=postgres
DB_PASSWORD=your-db-password

# Legacy/default sender used by current setup and as fallback.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=you@gmail.com
SENDER_PASSWORD=your-app-password
ADMIN_EMAILS=you@gmail.com,gautam@rirabh.com

# Optional explicit sender for rirabh.
RIRABH_SMTP_HOST=smtp.gmail.com
RIRABH_SMTP_PORT=587
RIRABH_SENDER_EMAIL=you@gmail.com
RIRABH_SENDER_PASSWORD=your-app-password
RIRABH_ADMIN_EMAILS=you@gmail.com,gautam@rirabh.com

# Sender for callerspot.
CALLERSPOT_SMTP_HOST=smtp.gmail.com
CALLERSPOT_SMTP_PORT=587
CALLERSPOT_SENDER_EMAIL=callerspot@gmail.com
CALLERSPOT_SENDER_PASSWORD=callerspot-app-password
CALLERSPOT_ADMIN_EMAILS=callerspot@gmail.com

# SMTP sender for wowphone. These fall back to the legacy/default SMTP values.
WOWPHONE_SMTP_HOST=smtp.gmail.com
WOWPHONE_SMTP_PORT=587
WOWPHONE_SENDER_EMAIL=wowphone@gmail.com
WOWPHONE_SENDER_PASSWORD=wowphone-app-password
WOWPHONE_ADMIN_EMAILS=wowphone@gmail.com

# Optional explicit sender for oojack. Falls back to the legacy/default SMTP
# values above if left unset (do not set these to blank strings, or they will
# override the fallback with an empty value).
# OOJACK_SMTP_HOST=smtp.gmail.com
# OOJACK_SMTP_PORT=587
# OOJACK_SENDER_EMAIL=oojack@gmail.com
# OOJACK_SENDER_PASSWORD=oojack-app-password
# OOJACK_ADMIN_EMAILS=oojack@gmail.com

# Mailgun for wowpbx.
WOWPBX_MAILGUN_API_KEY=
WOWPBX_MAILGUN_DOMAIN=
WOWPBX_MAILGUN_FROM_EMAIL=
WOWPBX_MAILGUN_FROM_NAME=wowpbx
WOWPBX_MAILGUN_ADMIN_EMAILS=

# Zoho CRM lead sync (optional; leave blank to disable). DC = data center suffix,
# e.g. "in" for zoho.in, "com" for zoho.com, "eu" for zoho.eu.
ZOHO_DC=eu
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
