SECRET_KEY=your-secret-key-here
LEADS_API_KEY=your-api-key-here

DB_HOST=localhost
DB_PORT=5432
DB_NAME=leads_db
DB_USER=postgres
DB_PASSWORD=your-db-password

# Legacy/default sender used by current setup and as fallback.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=you@gmail.com
SENDER_PASSWORD=your-app-password
ADMIN_EMAILS=you@gmail.com,gautam@rirabh.com

# Optional explicit sender for rirabh.
RIRABH_SMTP_HOST=smtp.gmail.com
RIRABH_SMTP_PORT=587
RIRABH_SENDER_EMAIL=you@gmail.com
RIRABH_SENDER_PASSWORD=your-app-password
RIRABH_ADMIN_EMAILS=you@gmail.com,gautam@rirabh.com

# Sender for callerspot.
CALLERSPOT_SMTP_HOST=smtp.gmail.com
CALLERSPOT_SMTP_PORT=587
CALLERSPOT_SENDER_EMAIL=callerspot@gmail.com
CALLERSPOT_SENDER_PASSWORD=callerspot-app-password
CALLERSPOT_ADMIN_EMAILS=callerspot@gmail.com

# Mailgun for wowpbx.
WOWPBX_MAILGUN_API_KEY=
WOWPBX_MAILGUN_DOMAIN=
WOWPBX_MAILGUN_FROM_EMAIL=
WOWPBX_MAILGUN_FROM_NAME=wowpbx
WOWPBX_MAILGUN_ADMIN_EMAILS=
